# ZeroHertz Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./zerohertz.db
SQLITE_DB_PATH=zerohertz.db

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
MAX_AUDIO_PAYLOAD_BYTES=5242880

# DSP DTMF Parameters
DSP_SAMPLE_RATE_DEFAULT=8000
DSP_MIN_FRAME_MS=20.0
DSP_MIN_TONE_DURATION_MS=40.0
DSP_MIN_SILENCE_DURATION_MS=40.0
DSP_ENERGY_THRESHOLD=1e-4
DSP_TWIST_MIN_DB=-6.0
DSP_TWIST_MAX_DB=6.0
DSP_SECOND_HARMONIC_MAX_RATIO=0.15

# Agent & Portal Automation
PORTAL_URL=http://localhost:8000/portal.html
CONFIRMATION_TIMEOUT_SECONDS=120
HEADLESS_BROWSER=true

# Optional Gemini Integration
GEMINI_API_KEY=
